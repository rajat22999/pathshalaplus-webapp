# Base URL of the Pathshala Plus API (without a trailing slash).
# The client appends /api/v1 automatically.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The client application type sent on login. This web app is the CRM console.
# Allowed roles for "crm": admin, staff.
NEXT_PUBLIC_APP_TYPE=crm

# --- Firebase Auth (public config; safe to expose to the browser) -----------
# From Firebase console -> Project settings -> Your apps -> Web app.
# Leave BLANK to fall back to the legacy backend OTP flow (no SMS spend).
# NOTE: NEXT_PUBLIC_* are inlined at BUILD time, so whatever machine or CI job
# runs `next build` must have these set — setting them at runtime is too late.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
